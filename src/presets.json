[{"id":"current","name":"Current districts (2025–26)","desc":"The 32 community school districts as they exist today. Note how unequal they are in size: the largest has several times the enrollment of the smallest. Zones follow DOE elementary school zones. Schools located outside their own district (like Beacon High School, District 3, located in District 2) are counted in the district they report to.","K":32,"mode":"C","weights":null,"plan":"","pins":[47,80,118,174,184,214,327,361,422,447,601,622,761]},{"id":"equal","name":"Equal size, compact","desc":"Redrawn from scratch: every district within 5% of its borough's ideal enrollment, shapes as compact as possible. Seats are re-apportioned to boroughs by enrollment.","K":32,"mode":"C","weights":{"pop":0.5,"compact":3},"plan":"","pins":[]},{"id":"econ","name":"Economic balance","desc":"Equal size, but optimized so each district's share of students in poverty is as close to the citywide rate as geography allows.","K":32,"mode":"C","weights":{"pop":0.2,"compact":0.5,"econ":5},"plan":"","pins":[]},{"id":"race","name":"Racial/ethnic integration","desc":"Equal size, optimized so each district's racial/ethnic mix mirrors the city (minimizes the Theil segregation index).","K":32,"mode":"C","weights":{"pop":0.2,"compact":0.5,"race":5},"plan":"","pins":[]},{"id":"blend","name":"Balanced blend","desc":"A middle path: equal size, reasonably compact, with moderate weight on both economic and racial/ethnic balance.","K":32,"mode":"C","weights":{"pop":0.3,"compact":1,"econ":3,"race":3},"plan":"","pins":[]},{"id":"minchange","name":"Fix sizes, minimal change","desc":"Starts from today's map and keeps each borough's current number of districts, moving as few students as possible to bring each district within 5% of its borough average.","K":32,"mode":"C","weights":{"pop":0.3,"compact":0.3,"change":5},"plan":"","pins":[80,361]}]